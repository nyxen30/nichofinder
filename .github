name: Atualizar Niche Finder

on:
  schedule:
    - cron: '17 9 * * *'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: niche-finder
  cancel-in-progress: false

jobs:
  atualizar:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Buscar canais novos
        env:
          YT_API_KEY: ${{ secrets.YT_API_KEY }}
          YT_API_KEYS: ${{ secrets.YT_API_KEYS }}
        run: node scripts/update.mjs
      - name: Salvar resultado
        run: |
          git config user.name "niche-finder-bot"
          git config user.email "niche-finder-bot@users.noreply.github.com"
          git add site/data/channels.json data/state.json
          git diff --cached --quiet || git commit -m "Atualiza canais $(date -u +%Y-%m-%d)"
          git push
